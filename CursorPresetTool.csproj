<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<UseWPF>false</UseWPF>
		<UseWindowsForms>false</UseWindowsForms>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>
	<ItemGroup>
		<Content Include="README.md" CopyToOutputDirectory="PreserveNewest"/>
		<Content Include="LICENSE.txt" CopyToOutputDirectory="PreserveNewest"/>
		<Content Include="CursorPresetTool.bat" CopyToOutputDirectory="PreserveNewest"/>
		<Content Include="AddPreset.bat" CopyToOutputDirectory="PreserveNewest"/>
		<Content Include="presets\**\*.*" CopyToOutputDirectory="PreserveNewest"/>
	</ItemGroup>

	<Target Name="CopyContentOnPublish" AfterTargets="Publish">
		<Copy SourceFiles="README.md" DestinationFolder="$(PublishDir)"/>
		<Copy SourceFiles="LICENSE.txt" DestinationFolder="$(PublishDir)"/>
		<Copy SourceFiles="CursorPresetTool.bat" DestinationFolder="$(PublishDir)"/>
		<Copy SourceFiles="AddPreset.bat" DestinationFolder="$(PublishDir)"/>
		<MakeDir Directories="$(PublishDir)\presets"/>
	</Target>
</Project>
