<Window x:Class="CursorPresetTool.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CursorPresetTool.Gui.Converters"
        xmlns:loc="clr-namespace:CursorPresetTool.Gui.Localization"
        Title="{loc:Loc Key=MainWindow.Title}"
        Height="500"
        Width="800"
        MinHeight="500"
        MinWidth="800"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <local:BoolToCollapsedConverter x:Key="BoolToCollapsed" />
        <!-- ヘッダーのアイコンボタン共通スタイル -->
        <Style x:Key="HeaderIconButton"
               TargetType="Button">
            <Setter Property="Width"
                    Value="32" />
            <Setter Property="Height"
                    Value="32" />
            <Setter Property="Padding"
                    Value="0" />
            <Setter Property="Margin"
                    Value="4,0,0,0" />
            <Setter Property="FontFamily"
                    Value="Segoe Fluent Icons" />
            <Setter Property="FontSize"
                    Value="16" />
            <Setter Property="Background"
                    Value="#F5F5F5" />
            <Setter Property="BorderBrush"
                    Value="#CCCCCC" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Center" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <!-- 上：ヘッダー行 / 下：本体 -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="4" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 左：一覧 / 右：詳細-->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <!-- 上部ヘッダー（左側：一覧 + インポート系） -->
        <Border Grid.Row="0"
                Grid.Column="0"
                BorderBrush="Gray"
                BorderThickness="1"
                Padding="4"
                CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 左：ラベル -->
                <TextBlock Grid.Column="0"
                           Text="{loc:Loc Key=MainWindow.Header.PresetList}"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           Margin="0,0,8,0" />

                <!-- 右：アイコンボタン群 -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <!-- ＋メニュー（新規 / インポート） -->
                    <Button Style="{StaticResource HeaderIconButton}"
                            ToolTip="{loc:Loc Key=MainWindow.ToolTip.AddPreset}"
                            Click="AddPresetButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{loc:Loc Key=MainWindow.Button.Create}"
                                          Click="NewPresetMenuItem_Click" />
                                <Separator />
                                <MenuItem Header="{loc:Loc Key=MainWindow.Button.ImportFolder}"
                                          Click="ImportFolderButton_Click" />
                                <MenuItem Header="{loc:Loc Key=MainWindow.Button.ImportZip}"
                                          Click="ImportZipButton_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                        <!-- ＋アイコン -->
                        <TextBlock Text="&#xE710;" />
                        <!-- Segoe Fluent の＋みたいなやつ -->
                    </Button>

                    <!-- 再読み込み -->
                    <Button Style="{StaticResource HeaderIconButton}"
                            ToolTip="{loc:Loc Key=MainWindow.ToolTip.Reload}"
                            Click="ReloadButton_Click">
                        <TextBlock Text="&#xE72C;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 上部ヘッダー（右側：詳細 + export/apply） -->
        <Border Grid.Row="0"
                Grid.Column="2"
                BorderBrush="Gray"
                BorderThickness="1"
                Padding="4"
                CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 左：ラベル -->
                <TextBlock Grid.Column="0"
                           Text="{loc:Loc Key=MainWindow.Header.PresetDetail}"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />

                <!-- 右：export / apply アイコンボタン -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <!-- 編集モードへ -->
                    <Button Style="{StaticResource HeaderIconButton}"
                            ToolTip="{loc:Loc Key=MainWindow.ToolTip.Edit}"
                            Click="EditButton_Click">
                        <TextBlock Text="&#xE70F;" />
                    </Button>

                    <!-- 適用 -->
                    <Button Style="{StaticResource HeaderIconButton}"
                            ToolTip="{loc:Loc Key=MainWindow.ToolTip.Apply}"
                            Click="ApplyButton_Click">
                        <TextBlock Text="&#xE8FB;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 左：一覧本体 ===== -->
        <Border Grid.Row="2"
                Grid.Column="0"
                BorderBrush="Gray"
                BorderThickness="1"
                Padding="4"
                CornerRadius="4">
            <DockPanel>
                <ListBox x:Name="PresetListBox"
                         ItemsSource="{Binding Presets}"
                         SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                         Margin="0,0,0,0"
                         BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         PreviewMouseRightButtonDown="PresetListBox_PreviewMouseRightButtonDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#DDDDDD"
                                    BorderThickness="0,0,0,1"
                                    Padding="8"
                                    ToolTip="{Binding FolderPath}">

                                <!-- 適用中なら背景色を変える -->
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background"
                                                Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsApplied}"
                                                         Value="True">
                                                <Setter Property="Background"
                                                        Value="#D0E6FF" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <!-- 本体表示 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <!-- ピン用の固定幅カラム（常に幅は確保） -->
                                        <ColumnDefinition Width="22" />
                                        <!-- テキスト用 -->
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- ピンアイコン（2行ぶち抜き） -->
                                    <TextBlock Grid.Row="0"
                                               Grid.Column="0"
                                               Grid.RowSpan="2"
                                               Text="&#xE718;"
                                               FontFamily="Segoe Fluent Icons"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Left">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility"
                                                        Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPinned}"
                                                                 Value="True">
                                                        <Setter Property="Visibility"
                                                                Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- 表示名（pack.json の PackName） -->
                                    <TextBlock Grid.Row="0"
                                               Grid.Column="1"
                                               Text="{Binding PackName}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />

                                    <!-- フォルダ名（PresetInfo.Name） -->
                                    <TextBlock Grid.Row="1"
                                               Grid.Column="1"
                                               Text="{Binding Name, StringFormat=({0})}"
                                               FontSize="11"
                                               Foreground="Gray"
                                               Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>

                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                    <!-- ★ ListBox 全体にコンテキストメニューを付ける -->
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{loc:Loc Key=MainWindow.Button.Pin}"
                                      Click="PinPresetMenuItem_Click"
                                      Visibility="{Binding IsPinned, Converter={StaticResource BoolToCollapsed}}" />
                            <MenuItem Header="{loc:Loc Key=MainWindow.Button.Unpin}"
                                      Click="UnpinPresetMenuItem_Click"
                                      Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}" />
                            <Separator />
                            <MenuItem Header="{loc:Loc Key=MainWindow.Button.OpenFolder}"
                                      Click="OpenFolderMenuItem_Click" />
                            <Separator />
                            <MenuItem Header="{loc:Loc Key=MainWindow.Button.Rename}"
                                      Click="RenamePresetMenuItem_Click" />
                            <MenuItem Header="{loc:Loc Key=MainWindow.Button.Copy}"
                                      Click="DuplicatePresetMenuItem_Click" />
                            <Separator />
                            <MenuItem Header="{loc:Loc Key=MainWindow.Button.Delete}"
                                      Click="DeletePresetMenuItem_Click" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ===== 右：詳細本体 ===== -->
        <Border Grid.Row="2"
                Grid.Column="2"
                BorderBrush="Gray"
                BorderThickness="1"
                Padding="10"
                CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- タイトル＋基本情報 -->
                <StackPanel Grid.Row="0">
                    <TextBlock Text="{Binding SelectedPreset.PackName}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal"
                                Margin="0,4,0,0">
                        <!-- 作者 -->
                        <TextBlock Margin="0,0,12,0">
                            <Run Text="{loc:Loc Key=MainWindow.Label.Author}" />
                            <Run Text=": " />
                            <Run Text="{Binding SelectedPreset.Author, Mode=OneWay}" />
                        </TextBlock>

                        <!-- バージョン -->
                        <TextBlock>
                            <Run Text="{loc:Loc Key=MainWindow.Label.Version}" />
                            <Run Text=": " />
                            <Run Text="{Binding SelectedPreset.Version, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <!-- 説明 -->
                <Border Grid.Row="1"
                        Margin="0,8,0,0"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="6">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding SelectedPreset.Description}"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis" />
                    </ScrollViewer>
                </Border>

                <!-- カーソル項目一覧 見出し -->
                <TextBlock Grid.Row="2"
                           Text="{loc:Loc Key=MainWindow.Label.CursorItems}"
                           FontWeight="Bold"
                           Margin="0,12,0,6" />

                <!-- カーソル項目一覧 本体 -->
                <Border Grid.Row="3"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="4">
                    <ListView x:Name="CursorListView"
                              ItemsSource="{Binding CursorItems}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              SizeChanged="CursorListView_SizeChanged">

                        <!-- ヘッダーをリサイズできないようにする -->
                        <ListView.Resources>
                            <Style TargetType="{x:Type GridViewColumnHeader}">
                                <Setter Property="IsHitTestVisible"
                                        Value="False" />
                            </Style>

                            <!-- 行は幅いっぱいに広げる（デフォに近い） -->
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment"
                                        Value="Stretch" />
                                <Setter Property="VerticalContentAlignment"
                                        Value="Center" />
                            </Style>

                        </ListView.Resources>

                        <ListView.View>
                            <GridView>
                                <!-- 項目名＋キー名 -->
                                <GridViewColumn Header="{loc:Loc Key=MainWindow.Label.ItemCol}">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <DockPanel HorizontalAlignment="Stretch">
                                                <StackPanel Margin="4,0,0,0">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontWeight="SemiBold"
                                                               TextAlignment="Left" />
                                                    <TextBlock Text="{Binding KeyName, StringFormat=({0})}"
                                                               FontSize="11"
                                                               Foreground="Gray"
                                                               TextAlignment="Left"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- 適用中プレビュー -->
                                <GridViewColumn Header="{loc:Loc Key=MainWindow.Label.Current}">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <!-- ★ 細い枠付きのプレビューボックス -->
                                            <Border Width="32"
                                                    Height="32"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    BorderBrush="#CCCCCC"
                                                    BorderThickness="1"
                                                    CornerRadius="2"
                                                    Background="White">
                                                <Grid HorizontalAlignment="Center"
                                                      VerticalAlignment="Center">
                                                    <!-- 実画像 -->
                                                    <Image Source="{Binding CurrentImage}"
                                                           Stretch="None"
                                                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                           ToolTip="{Binding CurrentFullPath}">
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Setter Property="Opacity"
                                                                        Value="1" />
                                                                <Style.Triggers>
                                                                    <!-- Missing のときは透明に -->
                                                                    <DataTrigger Binding="{Binding IsCurrentMissing}"
                                                                                 Value="True">
                                                                        <Setter Property="Opacity"
                                                                                Value="0" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                    </Image>

                                                    <!-- Missingアイコン -->
                                                    <TextBlock Text="&#xE9CE;"
                                                               FontFamily="Segoe Fluent Icons"
                                                               FontSize="20"
                                                               Foreground="Gray"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility"
                                                                        Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCurrentMissing}"
                                                                                 Value="True">
                                                                        <Setter Property="Visibility"
                                                                                Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- プリセットプレビュー -->
                                <GridViewColumn Header="{loc:Loc Key=MainWindow.Label.Preset}">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <!-- ★ 同じく枠付き -->
                                            <Border Width="32"
                                                    Height="32"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    BorderBrush="#CCCCCC"
                                                    BorderThickness="1"
                                                    CornerRadius="2"
                                                    Background="White">
                                                <Grid HorizontalAlignment="Center"
                                                      VerticalAlignment="Center">
                                                    <Image Source="{Binding PresetImage}"
                                                           Stretch="None"
                                                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                           ToolTip="{Binding PresetFullPath}">
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Setter Property="Opacity"
                                                                        Value="1" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPresetMissing}"
                                                                                 Value="True">
                                                                        <Setter Property="Opacity"
                                                                                Value="0" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                    </Image>

                                                    <TextBlock Text="&#xE9CE;"
                                                               FontFamily="Segoe Fluent Icons"
                                                               FontSize="20"
                                                               Foreground="Gray"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility"
                                                                        Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPresetMissing}"
                                                                                 Value="True">
                                                                        <Setter Property="Visibility"
                                                                                Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
