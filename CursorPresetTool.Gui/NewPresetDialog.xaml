<Window x:Class="CursorPresetTool.Gui.NewPresetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CursorPresetTool.Gui.Localization"
        Title="{loc:Loc Key=NewPresetDialog.Title}"
        Height="220"
        Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{loc:Loc Key=NewPresetDialog.Header.Select}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />

        <StackPanel Grid.Row="1"
                    Margin="8,0,0,0">
            <RadioButton x:Name="EmptyRadio"
                         Content="{loc:Loc Key=NewPresetDialog.SelectItem.Empty}"
                         IsChecked="True"
                         Margin="0,0,0,4" />
            <RadioButton x:Name="FromSystemRadio"
                         Content="{loc:Loc Key=NewPresetDialog.SelectItem.Current}"
                         Margin="0,0,0,4" />
            <RadioButton x:Name="FromSelectedRadio"
                         Content="{loc:Loc Key=NewPresetDialog.SelectItem.Copy}"
                         Margin="0,0,0,4" />
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="{loc:Loc Key=NewPresetDialog.Button.OK}"
                    Width="80"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="OkButton_Click" />
            <Button Content="{loc:Loc Key=NewPresetDialog.Button.Cancel}"
                    Width="80"
                    IsCancel="True"
                    Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
